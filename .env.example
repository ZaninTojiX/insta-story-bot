# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# A dedicated Instagram account used only by this bot (not your personal one)
IG_USERNAME=

# Recommended: path to an Instaloader session file for IG_USERNAME (see README)
IG_SESSION_FILE=
# Alternative: password login (more likely to trigger Instagram checkpoints)
IG_PASSWORD=

# Optional: comma-separated Telegram user IDs allowed to use the bot (empty = everyone)
ALLOWED_USER_IDS=

# Optional tuning
COOLDOWN_SECONDS=20
MAX_STORIES=30
